# Dependencies
node_modules/
**/node_modules/

# Environment variables — NEVER commit these
.env
**/.env
!**/.env.example

# Build outputs
frontend/build/
frontend/.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Uploads (user-generated content)
backend/uploads/*
!backend/uploads/.gitkeep

# Package lock (keep package-lock.json, ignore yarn.lock if not used)
yarn.lock

# APK build artifacts (Capacitor/Cordova)
android/
ios/
*.apk
*.aab
*.ipa
